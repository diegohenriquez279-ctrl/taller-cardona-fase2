@model List<TallerCardona.Models.Reportes.VehiculoResumen>
@{
    ViewData["Title"] = "Resumen de vehículos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Resumen de vehículos y propietarios</h1>
    <a asp-action="Index" class="btn btn-secondary">Volver a vehículos</a>
</div>

<p class="text-muted">Listado generado con una consulta LINQ Join entre vehículos y clientes.</p>

@if (!Model.Any())
{
    <p class="text-muted">No hay vehículos para mostrar.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Año</th>
                    <th>Cliente propietario</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehiculo in Model)
                {
                    <tr>
                        <td>@vehiculo.Placa</td>
                        <td>@vehiculo.Marca</td>
                        <td>@vehiculo.Modelo</td>
                        <td>@vehiculo.Anio</td>
                        <td>@vehiculo.ClienteNombre</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
