<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil de publicación para IIS local (Fase 4, criterio 7).
  Uso (en una terminal de administrador, desde la carpeta TallerCardona del proyecto):
      dotnet publish -c Release -p:PublishProfile=IIS
  Copia la app ya compilada a C:\inetpub\TallerCardona.

  Aquí NO van claves ni cadenas de conexión: esas se configuran como variables
  de entorno del sitio en IIS (ver docs/fase4/DESPLIEGUE.md).
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Usa el runtime de .NET que instala el Hosting Bundle (no se copia .NET dentro de la app). -->
    <SelfContained>false</SelfContained>
    <!-- PublishUrl lo usa Visual Studio; PublishDir lo usa "dotnet publish". -->
    <PublishUrl>C:\inetpub\TallerCardona</PublishUrl>
    <PublishDir>C:\inetpub\TallerCardona\</PublishDir>
    <!-- false: no borra lo que ya está en la carpeta (por ejemplo, la carpeta Logs). -->
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
  </PropertyGroup>
</Project>
