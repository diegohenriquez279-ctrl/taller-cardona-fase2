@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <h1 class="h4 mb-3 text-center">Iniciar sesión</h1>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label"></label>
                        <input asp-for="Correo" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Clave" class="form-label"></label>
                        <input asp-for="Clave" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Clave" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
