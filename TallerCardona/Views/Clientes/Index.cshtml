@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
    var busqueda = ViewData["Busqueda"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Clientes</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo cliente</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="text" name="busqueda" value="@busqueda" class="form-control"
               placeholder="Buscar por nombre o teléfono" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No se encontraron clientes.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th class="text-center">Vehículos</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Nombre</td>
                    <td>@c.Telefono</td>
                    <td>@(c.Correo ?? "—")</td>
                    <td class="text-center">@c.Vehiculos.Count</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}