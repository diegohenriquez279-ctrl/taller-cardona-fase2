@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
    var busqueda = ViewData["Busqueda"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Clientes</h1>
    <div>
        <a asp-action="Resumen" class="btn btn-outline-primary">Resumen</a>
        <a asp-action="Create" class="btn btn-primary">Nuevo cliente</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@* Formulario normal de búsqueda: funciona aunque JavaScript falle o esté desactivado.
   Con JavaScript, clientes.js filtra la tabla mientras se escribe (sin recargar). *@
<form method="get" asp-action="Index" class="row g-2 mb-3" id="formBusqueda">
    <div class="col-sm-8 col-md-6">
        <input type="text" name="busqueda" value="@busqueda" class="form-control"
               id="txtBusqueda" autocomplete="off"
               data-url-buscar="@Url.Action("Buscar")"
               data-url-base="@Url.Content("~/Clientes")"
               data-puede-eliminar="@(User.IsInRole(Roles.Administrador) ? "true" : "false")"
               placeholder="Buscar por nombre o teléfono" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<p class="text-muted @(Model.Any() ? "d-none" : "")" id="sinResultados">No se encontraron clientes.</p>

@* table-responsive: en pantallas angostas (celular) la tabla se desplaza de lado dentro de este recuadro, sin desbordar la página. *@
<div class="table-responsive">
<table class="table table-hover align-middle @(Model.Any() ? "" : "d-none")" id="tablaClientes">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th class="text-center">Vehículos</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody id="cuerpoClientes">
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nombre</td>
                <td>@c.Telefono</td>
                <td>@(c.Correo ?? "—")</td>
                <td class="text-center">@c.Vehiculos.Count</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    @if (User.IsInRole(Roles.Administrador))
                    {
                        <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@section Scripts {
    <script src="~/js/clientes.js" asp-append-version="true"></script>
}
