@using TallerCardona.Models.Reportes
@model List<ClienteResumen>
@{
    ViewData["Title"] = "Resumen de clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Resumen de clientes</h1>
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>

<p class="text-muted">
    Cantidad de vehículos y de órdenes de trabajo de cada cliente, ordenado por los clientes con más órdenes.
</p>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay clientes registrados.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Teléfono</th>
                <th class="text-center">Vehículos</th>
                <th class="text-center">Órdenes de trabajo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@r.Id">@r.Nombre</a></td>
                    <td>@r.Telefono</td>
                    <td class="text-center">@r.CantidadVehiculos</td>
                    <td class="text-center">
                        <span class="badge @(r.CantidadOrdenes > 0 ? "text-bg-primary" : "text-bg-light")">@r.CantidadOrdenes</span>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-semibold">
                <td colspan="2">Total</td>
                <td class="text-center">@Model.Sum(r => r.CantidadVehiculos)</td>
                <td class="text-center">@Model.Sum(r => r.CantidadOrdenes)</td>
            </tr>
        </tfoot>
    </table>
}
