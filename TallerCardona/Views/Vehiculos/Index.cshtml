@model List<Vehiculo>
@{
    ViewData["Title"] = "Vehículos";
    var busqueda = ViewData["Busqueda"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Vehículos</h1>
    <a asp-action="Create" class="btn btn-primary">Registrar vehículo</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="text" name="busqueda" value="@busqueda" class="form-control"
               placeholder="Buscar por placa, marca, modelo o cliente" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No se encontraron vehículos.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Placa</th><th>Vehículo</th><th>Año</th><th>Cliente</th><th>Kilometraje</th><th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehiculo in Model)
                {
                    <tr>
                        <td>@vehiculo.Placa</td>
                        <td>@vehiculo.Marca @vehiculo.Modelo</td>
                        <td>@vehiculo.Anio</td>
                        <td>@(vehiculo.Cliente?.Nombre ?? "—")</td>
                        <td>@vehiculo.Kilometraje.ToString("N0") km</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@vehiculo.Id" class="btn btn-sm btn-outline-secondary">Ver historial</a>
                            <a asp-action="Edit" asp-route-id="@vehiculo.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@vehiculo.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
