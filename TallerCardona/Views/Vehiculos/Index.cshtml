@model List<Vehiculo>
@{
    ViewData["Title"] = "Vehículos";
    var busqueda = ViewData["Busqueda"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Vehículos</h1>
    <div class="d-flex gap-2">
        <a asp-action="Resumen" class="btn btn-outline-secondary">Resumen LINQ</a>
        <a asp-action="Create" class="btn btn-primary">Registrar vehículo</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3" id="formBusquedaVehiculos">
    <div class="col-sm-8 col-md-6">
        <input type="text" name="busqueda" value="@busqueda" class="form-control"
               id="txtBusquedaVehiculos" autocomplete="off"
               data-url-buscar="@Url.Action("Buscar", "Vehiculos")"
               data-url-details="@Url.Action("Details", "Vehiculos", new { id = "__id__" })"
               data-url-edit="@Url.Action("Edit", "Vehiculos", new { id = "__id__" })"
               data-url-delete="@Url.Action("Delete", "Vehiculos", new { id = "__id__" })"
               data-puede-eliminar="@(User.IsInRole(Roles.Administrador) ? "true" : "false")"
               placeholder="Buscar por placa, marca, modelo o cliente" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<p class="text-muted @(Model.Any() ? "d-none" : "")" id="sinResultadosVehiculos">No se encontraron vehículos.</p>

<div class="table-responsive @(Model.Any() ? "" : "d-none")" id="contenedorTablaVehiculos">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Placa</th><th>Vehículo</th><th>Año</th><th>Cliente</th><th>Kilometraje</th><th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody id="cuerpoVehiculos">
                @foreach (var vehiculo in Model)
                {
                    <tr>
                        <td>@vehiculo.Placa</td>
                        <td>@vehiculo.Marca @vehiculo.Modelo</td>
                        <td>@vehiculo.Anio</td>
                        <td>@(vehiculo.Cliente?.Nombre ?? "—")</td>
                        <td>@vehiculo.Kilometraje.ToString("N0") km</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@vehiculo.Id" class="btn btn-sm btn-outline-secondary">Ver historial</a>
                            <a asp-action="Edit" asp-route-id="@vehiculo.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (User.IsInRole(Roles.Administrador))
                            {
                                <a asp-action="Delete" asp-route-id="@vehiculo.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

@section Scripts {
    <script src="~/js/vehiculos.js" asp-append-version="true"></script>
}
