@model Vehiculo
@{
    ViewData["Title"] = "Historial del vehículo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Marca @Model.Modelo (@Model.Anio)</h1>
        <div class="text-muted">Placa: @Model.Placa</div>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar vehículo</a>
</div>

<dl class="row">
    <dt class="col-sm-3">Cliente propietario</dt><dd class="col-sm-9">@(Model.Cliente?.Nombre ?? "—")</dd>
    <dt class="col-sm-3">Color</dt><dd class="col-sm-9">@(Model.Color ?? "—")</dd>
    <dt class="col-sm-3">Kilometraje actual</dt><dd class="col-sm-9">@Model.Kilometraje.ToString("N0") km</dd>
</dl>

<h2 class="h5 mt-4">Historial de órdenes de trabajo</h2>
@if (Model.Ordenes.Count == 0)
{
    <div class="alert alert-info">Este vehículo todavía no tiene órdenes de trabajo registradas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Ingreso</th><th>Problema reportado</th><th>Estado</th><th>Kilometraje de ingreso</th></tr></thead>
            <tbody>
                @foreach (var orden in Model.Ordenes.OrderByDescending(o => o.FechaIngreso))
                {
                    <tr>
                        <td>@orden.FechaIngreso.ToString("dd/MM/yyyy")</td>
                        <td>@orden.ProblemaReportado</td>
                        <td>@orden.Estado</td>
                        <td>@orden.KilometrajeIngreso.ToString("N0") km</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" class="btn btn-secondary">Volver a vehículos</a>
