
@using TallerCardona.Models
@model IEnumerable<TallerCardona.Models.Presupuesto>

@{
    ViewData["Title"] = "Presupuestos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Gestión de presupuestos</h1>
            <p class="text-muted">
                Consulta los presupuestos de las órdenes de trabajo.
            </p>
        </div>
        <a asp-controller="OrdenesTrabajo"
           asp-action="Index"
           class="btn btn-primary">
            Ver órdenes de trabajo
        </a>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>N.º</th>
                    <th>Fecha</th>
                    <th>Orden de trabajo</th>
                    <th>Total estimado</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var presupuesto in Model)
                    {
                        <tr>
                            <td>@presupuesto.Id</td>
                            <td>@presupuesto.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-controller="OrdenesTrabajo"
                                   asp-action="Details"
                                   asp-route-id="@presupuesto.OrdenTrabajoId">
                                    Orden N.º @presupuesto.OrdenTrabajoId
                                </a>
                            </td>
                            <td class="fw-bold">
                                @presupuesto.TotalEstimado.ToString("C2")
                            </td>
                            <td>
                                @if (presupuesto.Estado == EstadoPresupuesto.Pendiente)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>
                                }
                                else if (presupuesto.Estado == EstadoPresupuesto.Autorizado)
                                {
                                    <span class="badge bg-success">
                                        Autorizado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Rechazado
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@presupuesto.Id"
                                   class="btn btn-sm btn-primary mb-1">
                                    Ver detalles
                                </a>

                                @if (presupuesto.Estado == EstadoPresupuesto.Pendiente)
                                {
                                    <form asp-action="Autorizar"
                                          asp-route-id="@presupuesto.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-success mb-1">
                                            Autorizar
                                        </button>
                                    </form>

                                    <form asp-action="Rechazar"
                                          asp-route-id="@presupuesto.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-danger mb-1">
                                            Rechazar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">
                            No hay presupuestos registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
