
@model TallerCardona.Models.OrdenTrabajo

@{
    ViewData["Title"] = "Registrar orden de trabajo";
}

<div class="container mt-4">
    <h1>Registrar orden de trabajo</h1>
    <p class="text-muted">Complete los datos del vehículo y el problema reportado.</p>

    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="VehiculoId" class="form-label">Vehículo</label>
                    <select asp-for="VehiculoId"
                            asp-items="ViewBag.Vehiculos"
                            class="form-select">
                        <option value="">Seleccione un vehículo</option>
                    </select>
                    <span asp-validation-for="VehiculoId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProblemaReportado" class="form-label">Problema reportado</label>
                    <textarea asp-for="ProblemaReportado"
                              class="form-control"
                              rows="3"
                              required></textarea>
                    <span asp-validation-for="ProblemaReportado" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="KilometrajeIngreso" class="form-label">Kilometraje de ingreso</label>
                    <input asp-for="KilometrajeIngreso"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control"
                           required />
                    <span asp-validation-for="KilometrajeIngreso" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Diagnostico" class="form-label">Diagnóstico (opcional)</label>
                    <textarea asp-for="Diagnostico"
                              class="form-control"
                              rows="2"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Observaciones" class="form-label">Observaciones (opcional)</label>
                    <textarea asp-for="Observaciones"
                              class="form-control"
                              rows="2"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Guardar orden</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
