
@model IEnumerable<TallerCardona.Models.OrdenTrabajo>

@{
    ViewData["Title"] = "Órdenes de trabajo";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Órdenes de trabajo</h1>
            <p class="text-muted">Consulta las órdenes registradas en el taller.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Registrar orden
        </a>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>N.º</th>
                    <th>Fecha de ingreso</th>
                    <th>Vehículo</th>
                    <th>Problema reportado</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var orden in Model)
                    {
                        <tr>
                            <td>@orden.Id</td>
                            <td>@orden.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td>@(orden.Vehiculo?.Placa ?? "Sin vehículo")</td>
                            <td>@orden.ProblemaReportado</td>
                            <td>@orden.Estado</td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@orden.Id"
                                   class="btn btn-sm btn-info">
                                    Ver detalles
                                </a>

                                <a asp-controller="Presupuestos"
                                   asp-action="Crear"
                                   asp-route-ordenTrabajoId="@orden.Id"
                                   class="btn btn-sm btn-success">
                                    Crear presupuesto
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">
                            No hay órdenes de trabajo registradas.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
