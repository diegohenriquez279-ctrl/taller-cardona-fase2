
@model TallerCardona.Models.OrdenTrabajo

@{
    ViewData["Title"] = "Detalle de orden de trabajo";
    var totalServicios = Model.Servicios.Sum(s => s.Subtotal);
    var totalRepuestos = Model.Repuestos.Sum(r => r.Subtotal);
    var totalOrden = totalServicios + totalRepuestos;
}

<div class="container mt-4">
    <h1 class="mb-3">Detalle de orden de trabajo</h1>

    <div class="card mb-4">
        <div class="card-header">Orden de trabajo N.º @Model.Id</div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Fecha de ingreso</dt>
                <dd class="col-sm-8">@Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4">Vehículo</dt>
                <dd class="col-sm-8">
                    @(Model.Vehiculo?.Placa ?? "Sin vehículo") —
                    @(Model.Vehiculo?.Marca ?? "") @(Model.Vehiculo?.Modelo ?? "")
                </dd>

                <dt class="col-sm-4">Problema reportado</dt>
                <dd class="col-sm-8">@Model.ProblemaReportado</dd>

                <dt class="col-sm-4">Diagnóstico</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.Diagnostico) ? "Sin diagnóstico" : Model.Diagnostico)
                </dd>

                <dt class="col-sm-4">Kilometraje de ingreso</dt>
                <dd class="col-sm-8">@Model.KilometrajeIngreso.ToString("N0") km</dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">@Model.Estado</dd>

                <dt class="col-sm-4">Observaciones</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.Observaciones) ? "Sin observaciones" : Model.Observaciones)
                </dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header"><h4 class="mb-0">Servicios realizados</h4></div>
        <div class="card-body">
            @if (Model.Servicios.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Servicio</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var servicio in Model.Servicios)
                            {
                                <tr>
                                    <td>@(servicio.Servicio?.Nombre ?? $"Servicio #{servicio.ServicioId}")</td>
                                    <td>@servicio.Cantidad</td>
                                    <td>@servicio.PrecioUnitario.ToString("C2")</td>
                                    <td>@servicio.Subtotal.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><th colspan="3" class="text-end">Total de servicios</th><th>@totalServicios.ToString("C2")</th></tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No se seleccionaron servicios para esta orden.</p>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header"><h4 class="mb-0">Repuestos utilizados</h4></div>
        <div class="card-body">
            @if (Model.Repuestos.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Repuesto</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var repuesto in Model.Repuestos)
                            {
                                <tr>
                                    <td>@(repuesto.Repuesto?.Nombre ?? $"Repuesto #{repuesto.RepuestoId}")</td>
                                    <td>@repuesto.Cantidad</td>
                                    <td>@repuesto.PrecioUnitario.ToString("C2")</td>
                                    <td>@repuesto.Subtotal.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><th colspan="3" class="text-end">Total de repuestos</th><th>@totalRepuestos.ToString("C2")</th></tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No se seleccionaron repuestos para esta orden.</p>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4>Resumen económico</h4>
            <div class="d-flex justify-content-between">
                <span>Total de servicios</span><span>@totalServicios.ToString("C2")</span>
            </div>
            <div class="d-flex justify-content-between">
                <span>Total de repuestos</span><span>@totalRepuestos.ToString("C2")</span>
            </div>
            <hr />
            <div class="d-flex justify-content-between fw-bold fs-5">
                <span>Total estimado</span><span>@totalOrden.ToString("C2")</span>
            </div>
            <hr />
            <h5>Presupuesto</h5>

            @if (Model.Presupuesto is not null)
            {
                <p>Total: <strong>@Model.Presupuesto.TotalEstimado.ToString("C2")</strong></p>
                <p>Estado: @Model.Presupuesto.Estado</p>
                <a asp-controller="Presupuestos" asp-action="Details"
                   asp-route-id="@Model.Presupuesto.Id" class="btn btn-info">
                    Ver presupuesto
                </a>
            }
            else if (totalOrden > 0)
            {
                <form asp-controller="Presupuestos" asp-action="Crear" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ordenTrabajoId" value="@Model.Id" />
                    <button type="submit" class="btn btn-success">Crear presupuesto</button>
                </form>
            }
            else
            {
                <p>Sin presupuesto registrado.</p>
                <p class="text-warning">Seleccione al menos un servicio o repuesto para crear el presupuesto.</p>
            }
        </div>
    </div>

    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>
