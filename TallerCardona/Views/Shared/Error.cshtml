@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center mt-4">
        <h1 class="h3 text-danger">Algo salió mal</h1>
        <p class="text-muted">
            Ocurrió un error inesperado al procesar su solicitud. Ya quedó registrado.
            Intente de nuevo en unos momentos.
        </p>

        @if (Model.ShowRequestId)
        {
            <p>
                Si el problema continúa, comunique este código al administrador:<br />
                <code class="fs-5">@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
    </div>
</div>
