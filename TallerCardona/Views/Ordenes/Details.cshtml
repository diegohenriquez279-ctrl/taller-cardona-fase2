@model OrdenTrabajo
@{
    ViewData["Title"] = "Detalle de la orden";
    var estadosPermitidos = (List<EstadoOrden>)ViewData["EstadosPermitidos"]!;
    var totalServicios = Model.Servicios.Sum(s => s.Subtotal);
    var totalRepuestos = Model.Repuestos.Sum(r => r.Subtotal);
}

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<h1 class="h3 mb-3">
    Orden #@Model.Id
    <span class="badge @Model.Estado.ClaseBadge() fs-6 align-middle">@Model.Estado.Nombre()</span>
</h1>

<dl class="row">
    <dt class="col-sm-3">Vehículo</dt>
    <dd class="col-sm-9">@(Model.Vehiculo is null ? "—" : $"{Model.Vehiculo.Placa} · {Model.Vehiculo.Marca} {Model.Vehiculo.Modelo} {Model.Vehiculo.Anio}")</dd>

    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@(Model.Vehiculo?.Cliente?.Nombre ?? "—")</dd>

    <dt class="col-sm-3">Fecha de ingreso</dt>
    <dd class="col-sm-9">@Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Fecha de entrega</dt>
    <dd class="col-sm-9">@(Model.FechaEntrega?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>

    <dt class="col-sm-3">Kilometraje de ingreso</dt>
    <dd class="col-sm-9">@Model.KilometrajeIngreso.ToString("N0") km</dd>

    <dt class="col-sm-3">Problema reportado</dt>
    <dd class="col-sm-9">@Model.ProblemaReportado</dd>

    <dt class="col-sm-3">Diagnóstico</dt>
    <dd class="col-sm-9">@(Model.Diagnostico ?? "—")</dd>

    <dt class="col-sm-3">Observaciones</dt>
    <dd class="col-sm-9">@(Model.Observaciones ?? "—")</dd>

    <dt class="col-sm-3">Servicios</dt>
    <dd class="col-sm-9">
        @if (!Model.Servicios.Any())
        {
            <span class="text-muted">Sin servicios registrados.</span>
        }
        else
        {
            <ul class="mb-0">
                @foreach (var s in Model.Servicios)
                {
                    <li>@s.Cantidad × @(s.Servicio?.Nombre ?? "Servicio") — @s.Subtotal.ToString("C")</li>
                }
            </ul>
        }
    </dd>

    <dt class="col-sm-3">Repuestos</dt>
    <dd class="col-sm-9">
        @if (!Model.Repuestos.Any())
        {
            <span class="text-muted">Sin repuestos registrados.</span>
        }
        else
        {
            <ul class="mb-0">
                @foreach (var r in Model.Repuestos)
                {
                    <li>@r.Cantidad × @(r.Repuesto?.Nombre ?? "Repuesto") — @r.Subtotal.ToString("C")</li>
                }
            </ul>
        }
    </dd>

    <dt class="col-sm-3">Total</dt>
    <dd class="col-sm-9">@((totalServicios + totalRepuestos).ToString("C"))</dd>
</dl>
@* Presupuesto y pagos: solo Administrador y Recepción (el mecánico no tiene acceso a esos módulos). *@
@if (User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Recepcion))
{
    var presupuesto = Model.Presupuesto;
    var totalPagado = Model.Pagos.Sum(p => p.Monto);
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Presupuesto</h5>
            @if (presupuesto is null)
            {
                <p class="mb-2 text-muted">Esta orden todavía no tiene presupuesto.</p>
            }
            else
            {
                <p class="mb-2">
                    <a asp-controller="Presupuestos" asp-action="Details" asp-route-id="@presupuesto.Id">Presupuesto N.º @presupuesto.Id</a>
                    — @presupuesto.TotalEstimado.ToString("C")
                    <span class="badge @(presupuesto.Estado == EstadoPresupuesto.Pendiente ? "bg-warning text-dark" : presupuesto.Estado == EstadoPresupuesto.Autorizado ? "bg-success" : "bg-danger")">@presupuesto.Estado</span>
                </p>
            }

            @* Se puede generar si no hay presupuesto o si el anterior fue rechazado (se regenera). *@
            @if (presupuesto is null || presupuesto.Estado == EstadoPresupuesto.Rechazado)
            {
                <form asp-controller="Presupuestos" asp-action="Crear" method="post" class="d-inline">
                    <input type="hidden" name="ordenTrabajoId" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary">
                        @(presupuesto is null ? "Generar presupuesto" : "Regenerar presupuesto")
                    </button>
                </form>
                @if (!Model.Servicios.Any() && !Model.Repuestos.Any())
                {
                    <small class="text-muted d-block mt-1">Agregue servicios o repuestos a la orden antes de generar el presupuesto.</small>
                }
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Pagos</h5>
            <p class="mb-2">
                <strong>Total de la orden:</strong> @((totalServicios + totalRepuestos).ToString("C"))
                @if (presupuesto?.Estado == EstadoPresupuesto.Autorizado)
                {
                    <span class="ms-2"><strong>Pagado:</strong> @totalPagado.ToString("C")</span>
                    <span class="ms-2"><strong>Saldo:</strong> @((presupuesto.TotalEstimado - totalPagado).ToString("C"))</span>
                }
            </p>

            <a asp-controller="Pagos" asp-action="Create" asp-route-ordenTrabajoId="@Model.Id" class="btn btn-warning">
                Registrar Pago
            </a>
            <a asp-controller="Pagos" asp-action="Index" asp-route-ordenTrabajoId="@Model.Id" class="btn btn-outline-secondary">
                Ver pagos
            </a>
        </div>
    </div>
}
@if (Model.Estado == EstadoOrden.Entregado)
{
    <p class="text-muted">La orden ya fue entregada; su estado no se puede cambiar.</p>
}
else
{
    <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post" class="row g-2 mb-3">
        <input type="hidden" name="volverA" value="Details" />
        <div class="col-sm-6 col-md-4">
            <select name="estado" class="form-select">
                @foreach (var e in estadosPermitidos)
                {
                    <option value="@e" selected="@(e == Model.Estado)">@e.Nombre()</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Cambiar estado</button>
        </div>
    </form>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Tablero" class="btn btn-outline-secondary">Ver tablero</a>
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
