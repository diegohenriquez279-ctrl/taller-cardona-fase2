@using TallerCardona.Models.Reportes
@model List<OrdenTrabajo>
@{
    ViewData["Title"] = "Tablero de órdenes";
    // Conteo calculado en SQL Server con GroupBy (ver OrdenTrabajoRepositorio.ContarPorEstado)
    var conteo = (List<ConteoPorEstado>)ViewData["Conteo"]!;
    var totalOrdenes = conteo.Sum(c => c.Cantidad);
    var todosLosEstados = Enum.GetValues<EstadoOrden>();
    var primero = todosLosEstados.First();
    var ultimo = todosLosEstados.Last();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tablero de órdenes</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">Ver listado</a>
        <a asp-action="Create" class="btn btn-primary">Nueva orden</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@* Aquí tablero.js muestra el mensaje del cambio de estado sin recargar *@
<div id="mensajeTablero" aria-live="polite"></div>

<div class="row row-cols-2 row-cols-md-6 g-2 mb-4">
    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body p-2">
                <div class="fs-3 fw-bold" data-conteo-total>@totalOrdenes</div>
                <div class="small text-muted">Total de órdenes</div>
            </div>
        </div>
    </div>
    @foreach (var c in conteo)
    {
        <div class="col">
            <div class="card text-center h-100">
                <div class="card-body p-2">
                    <div class="fs-3 fw-bold" data-conteo-estado="@c.Estado">@c.Cantidad</div>
                    <span class="badge @c.Estado.ClaseBadge()">@c.Estado.Nombre()</span>
                </div>
            </div>
        </div>
    }
</div>

@* data-estados: el orden de las columnas, para que tablero.js sepa cuál es la anterior y la siguiente *@
<div id="tablero" class="row row-cols-1 row-cols-md-5 g-2"
     data-estados="@string.Join(",", todosLosEstados)"
     data-url-cambiar="@Url.Action("CambiarEstadoAjax")"
     data-url-base="@Url.Content("~/Ordenes")">
    @foreach (var estado in todosLosEstados)
    {
        var ordenes = Model.Where(o => o.Estado == estado).OrderBy(o => o.FechaIngreso).ToList();
        <div class="col" data-columna="@estado">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge @estado.ClaseBadge()">@estado.Nombre()</span>
                <span class="text-muted small" data-conteo-columna="@estado">@conteo.First(c => c.Estado == estado).Cantidad</span>
            </div>

            <p class="text-muted small sin-ordenes @(ordenes.Any() ? "d-none" : "")">Sin órdenes.</p>

            <div class="tarjetas">
            @foreach (var o in ordenes)
            {
                <div class="card mb-2" data-orden-id="@o.Id" data-fecha="@o.FechaIngreso.ToString("o")">
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between">
                            <strong>#@o.Id</strong>
                            <span class="text-muted small">@o.FechaIngreso.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div>@(o.Vehiculo is null ? "—" : $"{o.Vehiculo.Placa} · {o.Vehiculo.Marca} {o.Vehiculo.Modelo}")</div>
                        <div class="text-muted small">@(o.Vehiculo?.Cliente?.Nombre ?? "—")</div>
                        <p class="small mt-1 mb-2">@o.ProblemaReportado</p>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <div class="d-flex gap-1 flechas">
                                @if (estado != primero && estado != ultimo)
                                {
                                    <form asp-action="CambiarEstado" asp-route-id="@o.Id" method="post">
                                        <input type="hidden" name="estado" value="@((EstadoOrden)((int)estado - 1))" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Mover a la etapa anterior">&larr;</button>
                                    </form>
                                }
                                @if (estado != ultimo)
                                {
                                    <form asp-action="CambiarEstado" asp-route-id="@o.Id" method="post">
                                        <input type="hidden" name="estado" value="@((EstadoOrden)((int)estado + 1))" />
                                        <button type="submit" class="btn btn-sm btn-primary" title="Mover a la siguiente etapa">&rarr;</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/tablero.js" asp-append-version="true"></script>
}